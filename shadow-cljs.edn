{:source-paths ["src"]
 :dependencies [[reagent "2.0.1"]
                [binaryage/devtools "1.0.7"]]
 :http {:port #shadow/env ["SHADOW_PORT" :as :int :default 9640] :host "0.0.0.0"}
 :nrepl {:port #shadow/env ["NREPL_CLJ" :as :int :default 9641] :host "0.0.0.0"}
 :dev-http {#shadow/env ["DEV_HTTP_PORT" :as :int :default 5173] {:root "public" :push-state/index "index.html"}}
 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn iris-demo.core/init!}}
   :compiler-options {:source-map true
                      :closure-defines {shadow.cljs.devtools.client.env/devtools-url
                                        #shadow/env ["SHADOW_DEVTOOLS_URL" :default "https://9640.irisdoes.work"]}}
   :devtools {:after-load iris-demo.core/reload!
              :devtools-url #shadow/env ["SHADOW_DEVTOOLS_URL" :default "https://9640.irisdoes.work"]}}}}
